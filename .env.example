# Copy to .env for local development. Never commit the filled-in file.
#
# Two kinds of variable live here:
#   VITE_*  — inlined into the browser bundle at build time. Public by
#             definition; never put a secret behind this prefix.
#   others  — server-only, read via process.env inside server functions.

# ----------------------------------------------------------------------
# Site
# ----------------------------------------------------------------------

# Absolute origin, no trailing slash. Used for canonical URLs, the sitemap,
# and the double opt-in redirect target. Change this and nothing else when
# the site moves to a different domain.
PUBLIC_SITE_URL=https://rahulvelapure.dpdns.org

# ----------------------------------------------------------------------
# Feature flags — all default to off
# ----------------------------------------------------------------------

VITE_ADS_ENABLED=false
VITE_AFFILIATE_ENABLED=false
VITE_NEWSLETTER_ENABLED=false

# ----------------------------------------------------------------------
# Newsletter (Brevo)
# ----------------------------------------------------------------------
# The signup uses confirmed opt-in. All three values below are required before
# the form will accept a subscription — without a template and a list there is
# no confirmation email to send, and the form refuses rather than silently
# falling back to single opt-in.

BREVO_API_KEY=

# Numeric id of the list new subscribers join *after* confirming.
BREVO_LIST_ID=

# Numeric id of the Brevo "Double opt-in confirmation" template. Create it
# under Campaigns > Templates and make sure it contains the {{ doubleoptin }}
# confirmation link, or subscribers will have nothing to click.
BREVO_DOI_TEMPLATE_ID=

# Signs the anti-spam form token and derives rate-limit keys. Any long random
# string; generate with:  openssl rand -base64 32
# Optional — falls back to BREVO_API_KEY — but set it so rotating the Brevo
# key does not invalidate in-flight forms.
NEWSLETTER_FORM_SECRET=

# ----------------------------------------------------------------------
# Analytics and verification — all optional, all off until set
# ----------------------------------------------------------------------

VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
